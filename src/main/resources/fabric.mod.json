{
  "schemaVersion": 1,
  "id": "mms_render_common",
  "version": "${version}",
  "name": "MMS Render Common",
  "description": "Shared render infrastructure for the MMS mods: animated Bedrock geo items, armor and entities, synced geo animation triggers, assets read from installed jars, the EMF/CEM layer pose relay.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "info.mudbourn.mmsrendercommon.MmsRenderCommon"
    ],
    "client": [
      "info.mudbourn.mmsrendercommon.client.MmsRenderCommonClient"
    ]
  },
  "mixins": [
    "mms_render_common.cemrelay.mixins.json",
    "mms_render_common.itemmodel.mixins.json",
    "mms_render_common.geoholder.mixins.json",
    "mms_render_common.geoarmor.mixins.json",
    "mms_render_common.legacy.mixins.json",
    "mms_render_common.sourcepack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
